# kb-console — TLS-фасад для доступа из локальной сети (трасса code-2026-09-26-030).
#
# Правило проекта (kb-console/USER_GUIDE.md): прямая публикация :8085 в сеть без TLS
# запрещена — Basic-пароль уходит base64 в каждом запросе. Поэтому консоль остаётся
# на 127.0.0.1:8085 (loopback, audit P1 У-1), а в сеть смотрит только этот фасад:
# HTTPS + локальный CA Caddy (`tls internal`) + allow-list подсети.
#
# Переносимость (офис/другой хост): задать CONSOLE_LAN_IP и CONSOLE_LAN_CIDR под свою
# сеть. Операторам — исключение прокси для адреса консоли: на хосте через ansible
# `docker_no_proxy` (ansible/inventory/group_vars/all.yml), в браузере — no-proxy правило.
#
# Корневой сертификат для операторов (раздать/установить в доверенные):
#   data/caddy/data/caddy/pki/authorities/local/root.crt
#
# Проверка конфига:  docker compose exec kb-console-tls caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
{
	admin off
	# Без редиректа :80 → :443: сайт внутренний и на нестандартном порту 8443,
	# а в host-сети листенер :80 открылся бы на ВСЕХ интерфейсах хоста.
	auto_https disable_redirects
	log {
		output stdout
		format json
	}
	# HTTP/3 отключён: UDP 8443 закрыт фаерволом, а анонс Alt-Svc h3 заставляет
	# браузер ждать неудачный QUIC прежде чем упасть на TCP. Для LAN-консоли h1/h2 достаточно.
	servers {
		protocols h1 h2
	}
}

# Удобный вход: http://<LAN_IP>/ → редирект на https://…:8443.
# Порт 80 служит ТОЛЬКО редиректом (никакой аутентификации и контента по http),
# иначе оператор, набравший адрес без схемы, получил бы ошибку Caddy.
# Исключение — корневой сертификат CA по /root.crt: публичный материал, чтобы
# каждый оператор мог поставить доверие сам (http://<LAN_IP>/root.crt → установить).
http://{$CONSOLE_LAN_IP} {
	bind {$CONSOLE_LAN_IP}

	handle /root.crt {
		root * /data/caddy/pki/authorities/local
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=kb-console-lan-ca.crt"
		file_server
	}

	handle {
		redir https://{$CONSOLE_LAN_IP}:8443{uri} permanent
	}
}

https://{$CONSOLE_LAN_IP}:8443 {
	# Access-лог в stdout (docker logs kb-console-tls): отладка доступа операторов.
	log {
		output stdout
		format json
	}

	tls internal

	# Слушать ТОЛЬКО LAN-интерфейс: на хосте есть virbr*/docker0 — bind 0.0.0.0
	# выставил бы консоль во все сети (в т.ч. во внутренние лаб-сети).
	bind {$CONSOLE_LAN_IP}

	# Второй контур после TLS: доступ только из разрешённой подсети.
	@lan remote_ip {$CONSOLE_LAN_CIDR}

	# 033-F3: liveness-эндпоинт консоли (/healthz, без auth) наружу НЕ выходит —
	# 403 первым handle-блоком (Caddy: only the first matching block is evaluated;
	# path-матчер конкретнее @lan). Доступен только loopback контейнера.
	handle /healthz {
		respond "denied" 403
	}

	handle @lan {
		# Консоль — NiceGUI (websocket): reverse_proxy сам обрабатывает upgrade.
		reverse_proxy 127.0.0.1:8085 {
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		respond "kb-console: доступ только из локальной сети" 403
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		-Server
	}
}

# ── MCP — тот же TLS-фасад (Б6.2, трасса arch-2026-10-05-ai-workspace) ──
# Участники ходят в MCP по HTTPS из LAN. Разрешён ТОЛЬКО путь /mcp (POST/GET);
# всё прочее — 403: /metrics (auth-exempt на бэкенде!), /docs, /openapi.json,
# /health*, /tokens. Порт 8444 (8443 занят консолью). Backend: mcp-server на
# 127.0.0.1:8000 (host-сеть). ВНИМАНИЕ (F10): :8000 слушает 0.0.0.0 — прямой
# LAN-доступ в обход фасада закрывается отдельно (firewall/bind).
https://{$CONSOLE_LAN_IP}:8444 {
	log {
		output stdout
		format json
	}
	tls internal
	bind {$CONSOLE_LAN_IP}

	@lan_mcp {
		remote_ip {$CONSOLE_LAN_CIDR}
		path /mcp
		method POST GET
	}
	@lan remote_ip {$CONSOLE_LAN_CIDR}

	handle @lan_mcp {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {remote_host}
			flush_interval -1
		}
	}
	handle @lan {
		respond "MCP: доступен только /mcp" 403
	}
	handle {
		respond "MCP: доступ только из локальной сети" 403
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		-Server
	}
}
