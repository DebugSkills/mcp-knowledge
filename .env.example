# ═══════════════════════════════════════════════════════════════════
# MCP Knowledge Server — Environment Configuration
# ═══════════════════════════════════════════════════════════════════
#
# ГЕНЕРАЦИЯ СЕКРЕТОВ (выполнить перед первым запуском):
#   openssl rand -hex 32          # 64-символьный hex-ключ (рекомендуется)
#   uuidgen                        # UUID v4 (проще, но слабее)
#   pwgen -s 32 1                  # человекочитаемый (если установлен pwgen)
#
# Ротация ключей (graceful, #18):
#   1. Сгенерировать новый ключ → добавить в JSON-массив
#      Пример: MCP_READ_KEYS=["old-key","new-key"]
#   2. docker compose restart mcp-server
#   3. Перевести всех клиентов на новый ключ
#   4. Убрать старый ключ из массива → restart

# Qdrant
QDRANT_URL=http://qdrant:6334
QDRANT_COLLECTION=knowledge

# Embedding (модель для эмбеддингов — НЕ LLM!)
EMBEDDING_BACKEND=auto          # auto | cpu | gpu
EMBEDDING_MODEL=BAAI/bge-m3     # BGE-M3: 1024d, мультиязычный (RU/EN)
MODELS_CACHE_DIR=/app/models_cache

# MCP Auth (мульти-ключи — JSON-массив, #18)
# Формат: JSON-массив строк. Для нескольких ключей: ["key1","key2","key3"]
# Сгенерировать: openssl rand -hex 32
MCP_READ_KEYS=["changeme-read-key"]
MCP_WRITE_KEYS=["changeme-write-key"]

# Git audit (#21)
GIT_AUDIT=true
KNOWLEDGE_DIR=/app/knowledge

# Pipeline
WORKERS=1                        # ИНВАРИАНТ — не менять!

# Rate limiting (Фаза 3 E2: token bucket, per-key, batch-aware)
# Read-ключ: 100 запросов/мин (~1.67 токенов/сек, burst 10)
# Write-ключ: 20 запросов/мин (~0.33 токенов/сек, burst 5)
# При превышении → JSON-RPC error MCP_RATE_LIMITED (-32003)
RATE_LIMIT_READ_PER_MIN=100
RATE_LIMIT_WRITE_PER_MIN=20

# ═══════════════════════════════════════════════════════════════════
# Air-gap / Offline Mode (Фаза 3 G5)
# ═══════════════════════════════════════════════════════════════════
#
# Для развёртывания на изолированном хосте без доступа в интернет.
# Модели должны быть предварительно загружены в models_cache/
# через scripts/offline-deploy.sh prepare (см. docs/air-gap-validation.md).
#
# HF_HUB_OFFLINE=1 — запрещает HuggingFace Hub любые сетевые запросы.
#   При включении модель загружается ТОЛЬКО из локального кэша.
#   Если артефакты отсутствуют — сервер упадёт с ошибкой при старте.
#
# TRANSFORMERS_OFFLINE=1 — запрещает библиотеке transformers сетевые
#   запросы. Работает на уровне токенизатора и конфигурации модели.
#   Должен быть включен ВМЕСТЕ с HF_HUB_OFFLINE=1.
#
# SENTENCE_TRANSFORMERS_HOME — путь к директории с кэшем моделей
#   внутри контейнера. Должен совпадать с docker-compose volume mount.
#   По умолчанию: /app/models_cache (см. MODELS_CACHE_DIR выше).
#
# Для обычного (online) развёртывания: закомментируйте эти переменные
# или установите HF_HUB_OFFLINE=0.

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
SENTENCE_TRANSFORMERS_HOME=/app/models_cache

# ═══════════════════════════════════════════════════════════════════
# РЕКОМЕНДАЦИИ ПО OLLAMA-МОДЕЛИ (LLM-агент, вызывающий MCP Tools)
# ═══════════════════════════════════════════════════════════════════
#
# Ollama запускается ОТДЕЛЬНО от MCP Knowledge Server.
# Это модель, которую AI-агент использует для reasoning и вызова
# MCP Tools (search_knowledge, get_knowledge_map, write_knowledge...).
#
# 🥇 qwen2.5:14b (РЕКОМЕНДУЕТСЯ)
#    Лучший баланс качество/скорость для русскоязычной тех. БЗ.
#    Отличный multilingual (RU/EN), strong reasoning, ~9 GB VRAM.
#    Установка: ollama pull qwen2.5:14b
#
# 🥈 qwen2.5:7b (лёгкий)
#    Для 8 GB VRAM. Базовая русс. поддержка, быстрый инференс.
#    Установка: ollama pull qwen2.5:7b
#
# 🥉 qwen2.5:32b (тяжёлый)
#    Максимальное качество. ~19 GB VRAM, нужно 24 GB+ GPU.
#    Установка: ollama pull qwen2.5:32b
#
# Альтернативы:
#   deepseek-r1:14b    — strong reasoning, слабее русский
#   llama3.1:8b        — хорош для EN, русский посредственный
#   gemma2:27b         — сильный multilingual, 16 GB VRAM
#
# ВАЖНО: BGE-M3 (EMBEDDING_MODEL выше) — это модель для
# эмбеддингов (превращает текст в векторы для Qdrant).
# Ollama-модель — это LLM для reasoning агента. Они НЕ заменяют
# друг друга, а работают в паре: LLM думает → вызывает MCP Tools →
# MCP Server ищет через BGE-M3 в Qdrant.
