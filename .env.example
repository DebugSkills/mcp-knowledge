# ═══════════════════════════════════════════════════════════════════
# MCP Knowledge Server — Environment Configuration
# ═══════════════════════════════════════════════════════════════════
#
# ГЕНЕРАЦИЯ СЕКРЕТОВ (выполнить перед первым запуском):
#   openssl rand -hex 32          # 64-символьный hex-ключ (рекомендуется)
#   uuidgen                        # UUID v4 (проще, но слабее)
#   pwgen -s 32 1                  # человекочитаемый (если установлен pwgen)
#
# Ротация ключей (graceful, #18):
#   1. Сгенерировать новый ключ → добавить в JSON-массив
#      Пример: MCP_READ_KEYS=["old-key","new-key"]
#   2. docker compose restart mcp-server
#   3. Перевести всех клиентов на новый ключ
#   4. Убрать старый ключ из массива → restart

# Топология (миграция code-2026-09-08-001): mcp-server на host-сети →
# видит bridge-контейнеры compose через loopback-порты хоста.
#   - qdrant  → http://localhost:6333 (REST; gRPC 6334)
#   - ollama  → http://localhost:11435 (ollama-КОНТЕЙНЕР; 11434 — host-ollama других проектов)
# DNS-имена сервисов (qdrant, ollama) из host-сети НЕдоступны.

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_PREFER_GRPC=false
QDRANT_COLLECTION=knowledge

# Embedding — ollama-контейнер (mxbai-embed-large: русская семантика OK,
# 1024-dim; bge-m3 из Ollama F16 — NaN-баг, отбракован)
EMBEDDING_BACKEND=ollama
OLLAMA_URL=http://localhost:11435
OLLAMA_MODEL=mxbai-embed-large
# Chat для analyze_content — qwen2.5:7b ТЕКСТОВАЯ (VL не влезает в 8GB на ollama 0.20.2)
OLLAMA_CHAT_MODEL=qwen2.5:7b
# EMBEDDING_MODEL — HF-токенизатор chunker (НЕ Ollama-модель!)
EMBEDDING_MODEL=BAAI/bge-m3
MODELS_CACHE_DIR=/app/models_cache

# MCP Auth (мульти-ключи — JSON-массив, #18)
# Формат: JSON-массив строк. Для нескольких ключей: ["key1","key2","key3"]
# Сгенерировать: openssl rand -hex 32
MCP_READ_KEYS=["changeme-read-key"]
MCP_WRITE_KEYS=["changeme-write-key"]
# Import-ключи (kb-console: read-tools + import_content, без delete/reindex)
MCP_IMPORT_KEYS=["changeme-import-key"]
# X-API-Key kb-console — должен входить в MCP_READ_KEYS (или IMPORT/WRITE)
MCP_API_KEY=changeme-console-key

# kb-console (адрес сервера и порт UI)
MCP_SERVER_URL=http://localhost:8000
CONSOLE_PORT=8085

# Git audit (#21)
GIT_AUDIT=true
KNOWLEDGE_DIR=/app/knowledge

# Pipeline
WORKERS=1                        # ИНВАРИАНТ — не менять!

# Rate limiting (Фаза 3 E2: token bucket, per-key, batch-aware)
# Read-ключ: 100 запросов/мин (~1.67 токенов/сек, burst 10)
# Write-ключ: 20 запросов/мин (~0.33 токенов/сек, burst 5)
# При превышении → JSON-RPC error MCP_RATE_LIMITED (-32003)
RATE_LIMIT_READ_PER_MIN=100
RATE_LIMIT_WRITE_PER_MIN=20

# ═══════════════════════════════════════════════════════════════════
# Air-gap / Offline Mode (Фаза 3 G5)
# ═══════════════════════════════════════════════════════════════════
#
# Для развёртывания на изолированном хосте без доступа в интернет.
# Ollama-модели переносятся в контейнер через ./data/ollama/models
# (см. ansible/roles/mcp_kb_transfer или scripts/offline-deploy.sh prepare).
#
# HF_HUB_OFFLINE=1 — запрещает HuggingFace Hub любые сетевые запросы
#   (токенизатор chunker EMBEDDING_MODEL загружается из локального кэша).
# TRANSFORMERS_OFFLINE=1 — то же для transformers.
# SENTENCE_TRANSFORMERS_HOME — кэш моделей внутри контейнера
#   (/app/models_cache, см. MODELS_CACHE_DIR выше).
#
# Для обычного (online) развёртывания: закомментируйте или HF_HUB_OFFLINE=0.

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
SENTENCE_TRANSFORMERS_HOME=/app/models_cache

# ═══════════════════════════════════════════════════════════════════
# РЕКОМЕНДАЦИИ ПО OLLAMA-МОДЕЛИ (LLM-агент, вызывающий MCP Tools)
# ═══════════════════════════════════════════════════════════════════
#
# ВНИМАНИЕ (миграция 2026-09): ollama проекта — КОНТЕЙНЕР compose на
# 11435 (модели в ./data/ollama/models). Host-ollama на 11434 — чужие
# проекты, его НЕ используем. Установка модели в контейнер:
#   docker compose exec ollama ollama pull <model>
#
# Модель для эмбеддингов (EMBEDDING/OLLAMA_MODEL): mxbai-embed-large.
# LLM-модель агента (reasoning, вызов MCP Tools) — выбирается вне
# сервера. Для этого стека в контейнере: qwen2.5:7b (8GB GPU).
#
# 🥇 qwen2.5:7b (текущая, 8 GB VRAM) — быстрый инференс, русский OK.
# 🥈 qwen2.5:14b (нужно ~9 GB VRAM) — лучший баланс, если GPU позволит.
# qwen2.5vl:7b (vision) НЕ влезает в 8GB на ollama 0.20.2 — только текст.
#
# ВАЖНО: EMBEDDING_MODEL (BAAI/bge-m3) — токенизатор для chunker, НЕ для
# векторов. Векторы даёт Ollama mxbai-embed-large. Не путать.
