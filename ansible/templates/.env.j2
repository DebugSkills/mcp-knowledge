# Data layout (code-2026-09-22-002): корень данных ВНЕ git-клона кода —
# docker-compose.yml интерполирует ${DATA_ROOT} (qdrant / ollama / console).
# Непустой абсолютный путь; пустая строка = конфигурационная ошибка.
DATA_ROOT={{ data_root }}

# Qdrant (контейнерный, mcp-server на host-сети → localhost)
QDRANT_URL=http://localhost:6333
QDRANT_PREFER_GRPC=false
QDRANT_COLLECTION=knowledge

# Embedding — ollama-КОНТЕЙНЕР (миграция code-2026-09-08-001, порт 11435)
EMBEDDING_BACKEND=ollama
OLLAMA_URL=http://localhost:11435
OLLAMA_MODEL=mxbai-embed-large
OLLAMA_CHAT_MODEL=qwen2.5:7b
EMBEDDING_MODEL=BAAI/bge-m3
MODELS_CACHE_DIR=/app/models_cache

# MCP Auth (мульти-ключи, #18)
MCP_READ_KEYS={{ vault_mcp_read_keys }}
MCP_WRITE_KEYS={{ vault_mcp_write_keys }}
MCP_IMPORT_KEYS={{ vault_mcp_import_keys }}

# Git audit (#21)
GIT_AUDIT=true
KNOWLEDGE_DIR=/app/knowledge

# Pipeline
WORKERS=1

# kb-console
MCP_SERVER_URL=http://localhost:8000
CONSOLE_PORT=8085
MCP_API_KEY={{ vault_mcp_console_key }}
# kb-console auth (002): пароль из vault; auto → ON при заданном пароле (prod: required)
CONSOLE_HOST=127.0.0.1
CONSOLE_PASSWORD={{ vault_console_password | default('') }}
CONSOLE_AUTH={{ console_auth_mode | default('auto') }}
# LAN TLS-фасад kb-console (Caddy, трассы 030/033-F2): LAN-адрес хоста + allow-list подсетей.
# CIDR — ПРОБЕЛ-разделённый список (Caddy {$VAR} раскрывается в несколько токенов).
# Пустой CONSOLE_LAN_IP ⇒ kb-console-tls fail-closed (намеренно, docker-compose.yml:242).
# Подсети выводятся из mcp_kb_host_prepare__lan_cidr — того же списка, что и ufw-правила,
# поэтому дрейф «ufw ↔ allow-list фасада» (033-F2) невозможен by construction.
CONSOLE_LAN_IP={{ console_lan_ip | default('') }}
CONSOLE_LAN_CIDR={{ mcp_kb_host_prepare__lan_cidr | join(' ') }}
# kb-console roles (003): bootstrap-админ (первый старт) + per-role MCP-ключи
CONSOLE_USERS_FILE=/app/data/console/users.jsonl
CONSOLE_ADMIN_USER={{ console_admin_user | default('admin') }}
CONSOLE_ADMIN_PASSWORD={{ vault_console_password | default('') }}
MCP_API_KEY_ADMIN={{ vault_mcp_console_key }}
MCP_API_KEY_EDITOR={{ vault_mcp_editor_key | default('') }}
MCP_API_KEY_CONTRIBUTOR={{ vault_mcp_contributor_key | default('') }}

# ── LLM-шлюз + верстак (arch-2026-10-10-ws-airgap-layers) ──
# LITELLM_MASTER_KEY: litellm fail-closed boot-check (пусто → шлюз НЕ стартует) + Bearer верстака.
LITELLM_MASTER_KEY={{ vault_litellm_master_key | default('') }}
# Сервисные MCP-ключи верстака (read+zone=both / import+zone=both). Чеканятся на узле
# (python -m mcp_server.cli token create), значения — в vault.
WS_MCP_KEY={{ vault_ws_mcp_key | default('') }}
WS_MCP_IMPORT_KEY={{ vault_ws_mcp_import_key | default('') }}
# Модель локального контура верстака (litellm 'local' → ollama).
WS_LOCAL_MODEL={{ ws_local_model | default('qwen3:30b-a3b-instruct-2507-q4_K_M') }}
# Адрес ollama для контура local (litellm). host.docker.internal:11434 = host-ollama (мощные модели).
WS_LOCAL_OLLAMA_BASE={{ ws_local_ollama_base | default('host.docker.internal:11434') }}

# Rate limits
RATE_LIMIT_READ_PER_MIN=100
RATE_LIMIT_WRITE_PER_MIN=20
