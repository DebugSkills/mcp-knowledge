# Qdrant
QDRANT_URL=http://qdrant:6334
QDRANT_COLLECTION=knowledge

# Embedding
EMBEDDING_BACKEND={{ embedding_backend | default('auto') }}
EMBEDDING_MODEL=BAAI/bge-m3
MODELS_CACHE_DIR=/app/models_cache

# MCP Auth (мульти-ключи через запятую, #18)
MCP_READ_KEYS={{ vault_mcp_read_keys }}
MCP_WRITE_KEYS={{ vault_mcp_write_keys }}

# Git audit (#21)
GIT_AUDIT=true
KNOWLEDGE_DIR=/app/knowledge

# Pipeline
WORKERS=1
