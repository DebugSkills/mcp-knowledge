# Qdrant (контейнерный, mcp-server на host-сети → localhost)
QDRANT_URL=http://localhost:6333
QDRANT_PREFER_GRPC=false
QDRANT_COLLECTION=knowledge

# Embedding — ollama-КОНТЕЙНЕР (миграция code-2026-09-08-001, порт 11435)
EMBEDDING_BACKEND=ollama
OLLAMA_URL=http://localhost:11435
OLLAMA_MODEL=mxbai-embed-large
OLLAMA_CHAT_MODEL=qwen2.5:7b
EMBEDDING_MODEL=BAAI/bge-m3
MODELS_CACHE_DIR=/app/models_cache

# MCP Auth (мульти-ключи, #18)
MCP_READ_KEYS={{ vault_mcp_read_keys }}
MCP_WRITE_KEYS={{ vault_mcp_write_keys }}
MCP_IMPORT_KEYS={{ vault_mcp_import_keys }}

# Git audit (#21)
GIT_AUDIT=true
KNOWLEDGE_DIR=/app/knowledge

# Pipeline
WORKERS=1

# kb-console
MCP_SERVER_URL=http://localhost:8000
CONSOLE_PORT=8085
MCP_API_KEY={{ vault_mcp_console_key }}
# kb-console auth (002): пароль из vault; auto → ON при заданном пароле (prod: required)
CONSOLE_HOST=127.0.0.1
CONSOLE_PASSWORD={{ vault_console_password | default('') }}
CONSOLE_AUTH={{ console_auth_mode | default('auto') }}
# kb-console roles (003): bootstrap-админ (первый старт) + per-role MCP-ключи
CONSOLE_USERS_FILE=/app/data/console/users.jsonl
CONSOLE_ADMIN_USER={{ console_admin_user | default('admin') }}
CONSOLE_ADMIN_PASSWORD={{ vault_console_password | default('') }}
MCP_API_KEY_ADMIN={{ vault_mcp_console_key }}
MCP_API_KEY_EDITOR={{ vault_mcp_editor_key | default('') }}
MCP_API_KEY_CONTRIBUTOR={{ vault_mcp_contributor_key | default('') }}

# Rate limits
RATE_LIMIT_READ_PER_MIN=100
RATE_LIMIT_WRITE_PER_MIN=20
