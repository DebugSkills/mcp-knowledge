---
# Пример. Реальные значения — в vault.yml (ansible-vault create, в .gitignore)
vault_mcp_read_keys: '["read-key"]'
vault_mcp_write_keys: '["write-key"]'
vault_mcp_import_keys: '["import-key"]'
vault_mcp_console_key: "console-key"
# kb-console roles (003): per-role MCP-ключи (минтить через /tokens под админом;
# editor → уровень editor `mcp_e*`; пусто → fallback на MCP_API_KEY)
vault_mcp_editor_key: ""
vault_mcp_contributor_key: ""
# Пароль kb-console (HTTP Basic). Сгенерировать: openssl rand -hex 16
vault_console_password: "<сгенерируйте: openssl rand -hex 16>"
# Error→Rule TG-доставка (003 Ф4, P2-10): токен ТОЛЬКО здесь (ansible-vault),
# рендерится в {{ data_root }}/logs/errors/notify.json (0600, вне git).
# Бот создать через @BotFather. chat_id ЛИЧНОГО чата положительный, ГРУППЫ — отрицательный
# (вида -100xxxxxxxxxx); узнать: добавить бота в чат → https://api.telegram.org/bot<TOKEN>/getUpdates
# Пустые значения → errors_report.py --send-tg молча skip («TG: skip», exit 0).
vault_telegram_bot_token: ""
vault_telegram_chat_id: ""
# 016 §7.8: прокси обязателен на проде (отправка TG через корп. прокси,
# ProxyHandler; пусто → прямой fallback — только для локальной отладки).
# Формат: http://host:port (без кредов в URL; socks не поддерживается urllib).
vault_telegram_proxy: ""
