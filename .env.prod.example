# =============================================================================
# .env.prod.example — прод-конфигурация MCP Knowledge Server (air-gap bundle)
# Копируется в .env при deploy (offline-deploy.sh). ЗАМЕНИТЕ КЛЮЧИ ДОСТУПА!
# =============================================================================

# --- Qdrant (контейнер из compose: localhost:6333 REST) ---
QDRANT_URL=http://localhost:6333
QDRANT_PREFER_GRPC=false
QDRANT_COLLECTION=knowledge

# --- Embedding/Chat: Ollama (ollama-контейнер compose, порт 11435;
#     11434 занят host-ollama других проектов) ---
EMBEDDING_BACKEND=ollama
OLLAMA_URL=http://localhost:11435
OLLAMA_MODEL=mxbai-embed-large
# EMBEDDING_MODEL — HF-токенизатор для chunker (НЕ Ollama-модель!)
EMBEDDING_MODEL=BAAI/bge-m3

# --- Доступ (обязательно заменить!) ---
MCP_READ_KEYS=["changeme-read-key"]
MCP_WRITE_KEYS=["changeme-write-key"]
MCP_IMPORT_KEYS=["changeme-import-key"]   # kb-console: read-tools + import_content (без delete/reindex)

# --- SSOT / инварианты ---
GIT_AUDIT=true
KNOWLEDGE_DIR=/app/knowledge
WORKERS=1                        # ИНВАРИАНТ — не менять! (in-memory состояние)

# --- Rate limits ---
RATE_LIMIT_READ_PER_MIN=100
RATE_LIMIT_WRITE_PER_MIN=20

# --- Консоль мониторинга (kb-console, NiceGUI, порт 8085) ---
# CONSOLE_HOST=127.0.0.1 — loopback (security-by-default; поверх — HTTP Basic).
# 0.0.0.0 — ТОЛЬКО для bridge-режима docker run на клиентском хосте (docker-proxy
# ходит на IP контейнера, 127.0.0.1 внутри через -p недоступен), при этом публикацию
# держим на loopback хоста:
#   docker run -d --name kb-console \
#     -e MCP_SERVER_URL=http://<server-ip>:8000 -e MCP_API_KEY=<ключ> \
#     -e CONSOLE_HOST=0.0.0.0 -e CONSOLE_PASSWORD=<пароль> \
#     -p 127.0.0.1:8085:8085 kb-console:prod
CONSOLE_HOST=127.0.0.1
MCP_SERVER_URL=http://localhost:8000
MCP_API_KEY=changeme-console-key   # X-API-Key консоли — должен быть в MCP_IMPORT_KEYS сервера (импорт)

# Auth консоли (code-2026-09-20-002). ПРИ СЕТЕВОЙ ПУБЛИКАЦИИ пароль обязателен;
# для прода рекомендован CONSOLE_AUTH=required (пустой пароль → старт падает).
#   auto: пароль задан → auth ON; пусто + bind≠127.0.0.1 → WARN; off: явно выключено.
# ⚠️ Basic без TLS = креды base64 → сетевой доступ только ssh -L или TLS-фасад
# (Caddy/nginx поверх — без изменения приложения). Ротация = смена env + рестарт.
CONSOLE_PASSWORD=changeme-console-password
CONSOLE_AUTH=auto   # прод: required

# kb-console-roles (code-2026-09-21-001): per-role ключи MCP (прод — все три;
# пусто → fallback MCP_API_KEY = одна роль-legacy). Editor-ключ минтится через
# /tokens (mcp_e*-префикс) или CLI; contributor → import-ключ.
MCP_API_KEY_ADMIN=changeme-admin-key       # write-уровень (админ консоли)
MCP_API_KEY_EDITOR=                        # editor-уровень (mcp_e*-префикс)
MCP_API_KEY_CONTRIBUTOR=                   # import-уровень (только добавление)

# kb-console-roles: bootstrap-админ (сидится 1 раз при отсутствии активного
# админа; пароль НЕ логировать, после старта ротировать через /users).
# users.jsonl + users_audit.jsonl — volume ./data/console (хэши, не секреты).
# Непустой стор ПОЛНОСТЬЮ отключает CONSOLE_PASSWORD (скрытый админ запрещён).
CONSOLE_ADMIN_USER=admin
CONSOLE_ADMIN_PASSWORD=changeme-admin-password
