# =============================================================================
# .env.prod.example — прод-конфигурация MCP Knowledge Server (air-gap bundle)
# Копируется в .env при deploy (offline-deploy.sh). ЗАМЕНИТЕ КЛЮЧИ ДОСТУПА!
# =============================================================================

# --- Qdrant (контейнер из compose: localhost:6333 REST) ---
QDRANT_URL=http://localhost:6333
QDRANT_PREFER_GRPC=false
QDRANT_COLLECTION=knowledge

# --- Embedding: Ollama (системный сервис на хосте) ---
EMBEDDING_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mxbai-embed-large
# EMBEDDING_MODEL — HF-токенизатор для chunker (НЕ Ollama-модель!)
EMBEDDING_MODEL=BAAI/bge-m3

# --- Доступ (обязательно заменить!) ---
MCP_READ_KEYS=["changeme-read-key"]
MCP_WRITE_KEYS=["changeme-write-key"]

# --- SSOT / инварианты ---
GIT_AUDIT=true
KNOWLEDGE_DIR=/app/knowledge
WORKERS=1                        # ИНВАРИАНТ — не менять! (in-memory состояние)

# --- Rate limits ---
RATE_LIMIT_READ_PER_MIN=100
RATE_LIMIT_WRITE_PER_MIN=20
