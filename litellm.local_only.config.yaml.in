# Ф1, local_only-вариант (план Ф1 TODO #7): ext-полка отсутствует в конфиге.
# Зонная изоляция этим НЕ доказывается (→ Ф3); smoke-критерий: в /v1/models только local.
# Использование: GATEWAY_CONFIG=litellm.local_only.config.yaml make gateway-up
# Тест «egress-регресс зоны» (на узле, Ф1.E-ii): запрос model=ext через этот конфиг → 404 даже с ключом.
#
# ШАБЛОН (SSOT) — arch-2026-10-10-ai-ws-p2-1 Ф-B (R3): рендер envsubst (whitelist
# переменной LITELLM_MAX_PARALLEL) → int-литерал (K); см. шапку litellm.config.yaml.in
# (make gateway-render / ansible update.yml; fail-safe → K=1).

model_list:
  - model_name: local
    litellm_params:
      model: ollama/${WS_LOCAL_MODEL}
      api_base: http://mcp-knowledge-ollama:11434
      max_parallel_requests: ${LITELLM_MAX_PARALLEL}   # = K (int-литерал после рендера)
      timeout: 600

router_settings:
  num_retries: 0
  routing_strategy: simple-shuffle

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
