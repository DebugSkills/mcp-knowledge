# Ф1 (arch-2026-10-05-ai-workspace): 2 полки LiteLLM — local (ollama) + ext (deepseek).
# Инварианты: I5 — fallbacks НЕТ (private не должен уехать на ext); I12 — pin образа в compose.gateway.yml.
#
# ШАБЛОН (SSOT) — arch-2026-10-10-ai-ws-p2-1 Ф-B (R3): НЕ редактировать отрендеренный
# litellm.config.yaml (gitignored-артефакт). Рендер: envsubst с whitelist ИМЕННО
# переменной LITELLM_MAX_PARALLEL (другие плейсхолдеры не трогаются)
# → int-литерал в max_parallel_requests.
#   dev:     make gateway-render (prereq цели gateway-up; НЕ внутри make deploy — О-3)
#   air-gap: ansible apply-этап update.yml (после детекта K, до up)
# Источник K — scripts/gpu_k_detect.py (авто-детект free VRAM, R5); fail-safe: пусто/
# мусор/нет nvidia-smi → K=1 (не пустой литерал). Ручной тест-рендер K=2:
#   make gateway-render LITELLM_MAX_PARALLEL=2 → канарейка make gateway-canary K=2
#   → сверка с OLLAMA_NUM_PARALLEL (I7: один K в 4 носителях — litellm×2, WS_GPU_K,
#   OLLAMA_NUM_PARALLEL в compose×2).
#   ⚠️ Cap действует per-worker → в compose.gateway.yml обязан оставаться --num_workers 1.

model_list:
  # ── Полка local: ollama/qwen2.5:7b (внутренний контур) ──
  - model_name: local
    litellm_params:
      model: ollama/qwen2.5:7b
      api_base: http://mcp-knowledge-ollama:11434
      max_parallel_requests: ${LITELLM_MAX_PARALLEL}   # = K (int-литерал после рендера)
      timeout: 600

  # ── Полка ext: DeepSeek flash (внешний контур; ключ НЕ коммитится) ──
  - model_name: ext
    litellm_params:
      model: deepseek/deepseek-flash   # V4.1-Flash; лимит аккаунта = concurrency 2500 (НЕ RPM/TPM)
      api_key: os.environ/DEEPSEEK_API_KEY
      timeout: 300

router_settings:
  num_retries: 0            # 429 отдаём сразу; retry-политика — наш scheduler (Ф1-спека B.5)
  routing_strategy: simple-shuffle

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
